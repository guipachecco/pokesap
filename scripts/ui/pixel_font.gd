const ACCENTS := {
	"acute": ["..#", ".#."],
	"grave": ["#..", ".#."],
	"circ": [".#.", "#.#"],
	"tilde": [".#.#", "#.#."],
	"uml": ["#.#", "..."],
}

## letra acentuada -> [base, acento]
const COMPOSED := {
	"á": ["a", "acute"], "à": ["a", "grave"], "â": ["a", "circ"], "ã": ["a", "tilde"],
	"é": ["e", "acute"], "ê": ["e", "circ"], "í": ["ı", "acute"], "ó": ["o", "acute"],
	"ô": ["o", "circ"], "õ": ["o", "tilde"], "ú": ["u", "acute"], "ü": ["u", "uml"],
	"Á": ["A", "acute"], "À": ["A", "grave"], "Â": ["A", "circ"], "Ã": ["A", "tilde"],
	"É": ["E", "acute"], "Ê": ["E", "circ"], "Í": ["I", "acute"], "Ó": ["O", "acute"],
	"Ô": ["O", "circ"], "Õ": ["O", "tilde"], "Ú": ["U", "acute"],
	"ç": ["c", "cedilla"], "Ç": ["C", "cedilla"],
}

static var _font: FontFile


static func get_font() -> FontFile:
	if _font == null:
		_font = _build()
	return _font


## Retorna a matriz 11xW (Array de String) de um caractere.
static func _cell(ch: String) -> Array:
	var rows: Array = []
	if COMPOSED.has(ch):
		var base: String = COMPOSED[ch][0]
		var acc: String = COMPOSED[ch][1]
		rows = _cell(base)
		var w: int = rows[0].length()
		if acc == "cedilla":
			var cx := w / 2
			rows[9] = _put(rows[9], cx, "#")
			rows[10] = _put(rows[10], cx - 1, "#")
			return rows
		var mark: Array = ACCENTS[acc]
		var top := 0 if ch == ch.to_upper() else 2
		var mx: int = (w - (mark[0] as String).length()) / 2
		for r in 2:
			for i in (mark[r] as String).length():
				if mark[r][i] == "#":
					rows[top + r] = _put(rows[top + r], mx + i, "#")
		return rows
	var g: Array = GLYPHS[ch]
	var w: int = 0
	for r in g:
		w = maxi(w, r.length())
	for i in SIZE:
		rows.append(".".repeat(w))
	for i in g.size():
		rows[2 + i] = (g[i] as String).rpad(w, ".")
	return rows


static func _put(s: String, i: int, c: String) -> String:
	if i < 0 or i >= s.length():
		return s
	return s.substr(0, i) + c + s.substr(i + 1)


static func _build() -> FontFile:
	var chars: Array = GLYPHS.keys() + COMPOSED.keys()
	var cols := 16
	var cell_w := 8
	var img := Image.create(cols * cell_w, ceili(chars.size() / float(cols)) * SIZE, false, Image.FORMAT_RGBA8)
	var f := FontFile.new()
	var sz := Vector2i(SIZE, 0)
	f.fixed_size = SIZE
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.allow_system_fallback = false
	f.force_autohinter = false
	f.multichannel_signed_distance_field = false
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	f.set_cache_ascent(0, SIZE, ASCENT)
	f.set_cache_descent(0, SIZE, DESCENT)
	for idx in chars.size():
		var ch: String = chars[idx]
		var rows := _cell(ch)
		var w: int = rows[0].length()
		var ox := (idx % cols) * cell_w
		var oy := (idx / cols) * SIZE
		for y in SIZE:
			for x in w:
				if rows[y][x] == "#":
					img.set_pixel(ox + x, oy + y, Color.WHITE)
		var cp := ch.unicode_at(0)
		f.set_glyph_texture_idx(0, sz, cp, 0)
		f.set_glyph_uv_rect(0, sz, cp, Rect2(ox, oy, w, SIZE))
		f.set_glyph_size(0, sz, cp, Vector2(w, SIZE))
		f.set_glyph_offset(0, sz, cp, Vector2(0, -ASCENT))
		f.set_glyph_advance(0, SIZE, cp, Vector2(w + 1, 0))
	# espaço
	var sp := " ".unicode_at(0)
	f.set_glyph_advance(0, SIZE, sp, Vector2(4, 0))
	f.set_glyph_size(0, sz, sp, Vector2.ZERO)
	f.set_texture_image(0, sz, 0, img)
	return f
